# Copia este ficheiro como .env e enche os valores (a guía está no README)

# Neon: Dashboard → Connect → copia a "connection string"
DATABASE_URL="postgresql://usuario:contrasinal@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Google Cloud: credenciais OAuth (tipo "Aplicación web")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Unha cadea longa e aleatoria. Xérase con:  openssl rand -base64 32
NEXTAUTH_SECRET=""
# En local: http://localhost:3000 (en Vercel non fai falta)
NEXTAUTH_URL="http://localhost:3000"

# Contas que entran sempre como profesor (separadas por comas).
# Pon tamén o teu Gmail persoal: así non perdes o acceso se cambias de centro
ADMIN_EMAILS="amoronbandin@gmail.com,alejandro.moron@torrenteballester-edu.es"

# Nome do centro (aparece na pantalla de entrada). Pode quedar baleiro
SCHOOL_NAME="IES Torrente Ballester"

# Dominio do correo do centro. Opcional: permite dar de alta escribindo só
# "nome.apelido". Se o alumnado usa Gmail, déixao baleiro
SCHOOL_DOMAIN="torrenteballester-edu.es"

# Curso académico actual
SCHOOL_YEAR="2026-27"
