---
import Base from "../../../layouts/Base.astro";
import TaskList from "../../../components/TaskList.astro";
import { getCollection, render } from "astro:content";
import { u, materias, avisos, deberes, unidades, dataCurta, ESTADO } from "../../../lib/util";

export async function getStaticPaths() {
  const mats = await materias();
  return mats.map((m) => ({ params: { materia: m.id }, props: { m } }));
}
const { m } = Astro.props;
const mats = await materias();
const byId = new Map(mats.map((x) => [x.id, x]));
const [us, tasks, news, foros] = await Promise.all([
  unidades(m.id), deberes(m.id), avisos(m.id),
  getCollection("foros").then((f) => f.filter((x) => x.data.grupos.includes(m.id)).sort((a, b) => +b.data.data - +a.data.data)),
]);
const { Content } = await render(m);
---
<Base title={m.data.nome}>
  <div class={`stack c-${m.data.cor}`} style="gap:28px">
    <a href={u("/materias")} class="small muted" style="font-weight:600">← Materias</a>
    <div class="hero">
      <div class="row between">
        <span class="small" style="font-weight:700">{m.data.curso}</span>
        <button type="button" class="btn sm line mygroup-btn" data-mygroup={m.id} aria-pressed="false" style="background:var(--card)">Este é o meu grupo</button>
      </div>
      <h1>{m.data.nome}</h1>
      {m.data.descricion && <p style="color:var(--ink);opacity:.8;max-width:60ch">{m.data.descricion}</p>}
    </div>

    <div class="split">
      <section class="stack" style="gap:28px">
        <div class="card stack-sm" data-tasks-box>
          <div class="row between"><h2>Deberes</h2><button type="button" class="btn sm line" data-toggle-past>Ver as pasadas</button></div>
          {tasks.length === 0 ? <p class="muted small">Agora mesmo non hai deberes.</p> : <TaskList items={tasks} mats={byId} showGroup={false} />}
        </div>

        <div class="stack-sm">
          <h2>Unidades</h2>
          {us.length === 0 && <div class="empty">Aínda non hai unidades.</div>}
          {us.map((x) => (
            <a href={u(`/materias/${m.id}/${x.data.numero}`)} class="card tight hover row" style="flex-wrap:nowrap;gap:14px">
              <span class="kind" style={x.data.estado === "agora" ? "background:var(--c-fg);color:var(--card)" : ""}>
                <b style="font-family:var(--f-display);font-size:19px">{x.data.numero}</b>
              </span>
              <span class="min0" style="flex:1">
                <b style="display:block;line-height:1.3">{x.data.titulo}</b>
                <span class="small muted">{x.data.recursos.length} {x.data.recursos.length === 1 ? "material" : "materiais"}</span>
              </span>
              <span class={`pill ${x.data.estado === "agora" ? "" : "line"}`}>{ESTADO[x.data.estado]}</span>
            </a>
          ))}
        </div>
      </section>

      <aside class="stack">
        {m.body?.trim() && <div class="card prose small"><Content /></div>}
        {foros.length > 0 && (
          <div class="stack-sm">
            <h2>Para opinar</h2>
            {foros.map((f) => (
              <a href={f.data.ligazon} target="_blank" rel="noopener noreferrer" class="card tight hover stack-sm" style="gap:4px">
                <div class="row" style="gap:6px">{!f.data.aberto && <span class="pill line">Pechado</span>}<span class="tiny muted">{dataCurta(f.data.data)}</span></div>
                <b>{f.data.titulo} <span class="muted">↗</span></b>
                {f.body?.trim() && <span class="small muted">{f.body.trim()}</span>}
              </a>
            ))}
          </div>
        )}
        <div class="stack-sm">
          <h2>Avisos</h2>
          {news.length === 0 ? <p class="small muted">Sen avisos.</p> : news.slice(0, 5).map((a) => (
            <a href={u(`/avisos/${a.id}`)} class="card tight hover stack-sm" style="gap:2px">
              <span class="tiny muted">{dataCurta(a.data.data)}{a.data.grupos.length === 0 ? ", para todo o departamento" : ""}</span>
              <b>{a.data.titulo}</b>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>
