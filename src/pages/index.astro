---
import Base from "../layouts/Base.astro";
import TaskList from "../components/TaskList.astro";
import EventList from "../components/EventList.astro";
import { render } from "astro:content";
import sitio from "../data/sitio.json";
import { eventos } from "../lib/calendar";
import { u, isExternal, materias, avisos, deberes, unidades, dataCurta, sigla } from "../lib/util";

const mats = await materias();
const byId = new Map(mats.map((m) => [m.id, m]));
const tasks = await deberes();
const feed = (await avisos()).sort((a, b) => Number(b.data.fixado) - Number(a.data.fixado)).slice(0, 6);
const rendered = await Promise.all(feed.map(async (a) => (await render(a)).Content));
const agora = new Map(await Promise.all(mats.map(async (m) => [m.id, (await unidades(m.id)).find((x) => x.data.estado === "agora")] as const)));
const proximas = (await eventos()).eventos.slice(0, 5);
---
<Base>
  <div class="split">
    <section class="stack" style="gap:40px">
      <header class="pagehead">
        <span class="eyebrow">{sitio.departamento}</span>
        <h1>Salve<span style="color:var(--mark)">!</span></h1>
        <p class="lede" data-pending-count>Avisos, deberes e materiais de Latín e Grego.</p>
      </header>

      <div class="card stack-sm" data-filter-mine data-tasks-box>
        <div class="row between"><h2>Deberes</h2><span class="pill line" data-mine-name>Todos os grupos</span></div>
        {tasks.length === 0 ? <p class="empty">Aínda non hai deberes.</p> : <TaskList items={tasks} mats={byId} />}
        <div class="row between">
          <span class="tiny muted">Pulsa «Este é o meu grupo» na páxina da túa materia e aquí verás só os teus.</span>
          <button type="button" class="btn sm line" data-toggle-past>Ver as pasadas</button>
        </div>
      </div>

      <div class="stack-sm">
        <div class="section-title"><h2>Avisos</h2><a href={u("/avisos")} class="small muted">Todos os avisos →</a></div>
        <div class="feed">
          {feed.map((a, i) => {
            const C = rendered[i];
            const href = a.data.ligazon && (isExternal(a.data.ligazon) ? a.data.ligazon : u(a.data.ligazon));
            return (
              <article class="post-card">
                <div class="row" style="gap:12px">
                  <span class="tiny muted">{dataCurta(a.data.data)}</span>
                  {a.data.fixado && <span class="pill accent">Fixado</span>}
                  {a.data.grupos.map((g) => byId.get(g) && <span class={`pill c-${byId.get(g)!.data.cor}`}>{byId.get(g)!.data.nome}</span>)}
                  {a.data.etiqueta && <span class="pill line">{a.data.etiqueta}</span>}
                </div>
                <h3><a href={u(`/avisos/${a.id}`)}>{a.data.titulo}</a></h3>
                <div class="body"><C /></div>
                {href && <a href={href} class="textlink" {...(isExternal(href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}>Abrir →</a>}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <aside class="stack" style="gap:40px">
      <div class="stack-sm">
        <div class="section-title"><h2>Grupos</h2><span class="small muted">{sitio.curso}</span></div>
        <nav class="grouplist">
          {mats.map((m) => (
            <a href={u(`/materias/${m.id}`)} class={`c-${m.data.cor}`} data-group-card={m.id} data-group-name={m.data.nome}>
              <span class="code">{sigla(m)}</span>
              <b>{m.data.nome}, {m.data.curso}</b>
              <span class="sub">{agora.get(m.id) ? `Agora: ${agora.get(m.id)!.data.titulo}` : " "}</span>
            </a>
          ))}
        </nav>
      </div>

      {proximas.length > 0 && (
        <div class="stack-sm">
          <div class="section-title"><h2>Próximas datas</h2><a href={u("/calendario")} class="small muted">Calendario →</a></div>
          <EventList items={proximas} compact />
        </div>
      )}

      <div class="stack-sm">
        <div class="section-title"><h2>Atallos</h2></div>
        <div class="list">
          {sitio.palaestra && <a class="item" href={sitio.palaestra} target="_blank" rel="noopener noreferrer"><span></span><span class="t">Palaestra</span><span class="small muted">↗</span></a>}
          {sitio.pau && <a class="item" href={sitio.pau} target="_blank" rel="noopener noreferrer"><span></span><span class="t">Web da PAU</span><span class="small muted">↗</span></a>}
          <a class="item" href={u("/gramatica")}><span></span><span class="t">Gramática</span><span class="small muted">→</span></a>
          <a class="item" href={u("/biblioteca")}><span></span><span class="t">Biblioteca</span><span class="small muted">→</span></a>
          <a class="item" href={u("/saidas")}><span></span><span class="t">Viaxe e saídas</span><span class="small muted">→</span></a>
        </div>
      </div>
    </aside>
  </div>
</Base>
