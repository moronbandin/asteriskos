---
import Base from "../layouts/Base.astro";
import TaskList from "../components/TaskList.astro";
import Icon from "../components/Icon.astro";
import { render } from "astro:content";
import sitio from "../data/sitio.json";
import { u, materias, avisos, deberes, unidades, dataCurta, sigla } from "../lib/util";

const mats = await materias();
const byId = new Map(mats.map((m) => [m.id, m]));
const tasks = await deberes();
const feed = (await avisos()).sort((a, b) => Number(b.data.fixado) - Number(a.data.fixado)).slice(0, 6);
const rendered = await Promise.all(feed.map(async (a) => (await render(a)).Content));
const agora = new Map(await Promise.all(mats.map(async (m) => [m.id, (await unidades(m.id)).find((x) => x.data.estado === "agora")] as const)));
---
<Base>
  <div class="split">
    <section class="stack" style="gap:28px">
      <div class="big-hello">
        <span class="eyebrow">{sitio.departamento}</span>
        <h1>Salve<span style="color:var(--accent)">!</span></h1>
        <p class="muted" data-pending-count>Avisos, deberes e materiais de Latín e Grego.</p>
      </div>

      <div class="card stack-sm" data-filter-mine data-tasks-box>
        <div class="row between">
          <h2>Deberes</h2>
          <span class="pill line" data-mine-name>Todos os grupos</span>
        </div>
        {tasks.length === 0
          ? <p class="muted small">Aínda non hai deberes.</p>
          : <TaskList items={tasks} mats={byId} />}
        <div class="row between">
          <span class="tiny muted">Escolle o teu grupo na súa páxina e aquí verás só os teus.</span>
          <button type="button" class="btn sm line" data-toggle-past>Ver as pasadas</button>
        </div>
      </div>

      <div class="stack-sm">
        <div class="row between"><h2>Avisos</h2><a href={u("/avisos")} class="small muted">Ver todos →</a></div>
        <div class="feed">
          {feed.map((a, i) => {
            const C = rendered[i];
            return (
              <article class={`post-card ${a.data.fixado ? "pinned" : ""}`}>
                <div class="row" style="gap:8px">
                  {a.data.fixado && <span class="pill accent">Fixado</span>}
                  {a.data.etiqueta && <span class="pill">{a.data.etiqueta}</span>}
                  {a.data.grupos.map((g) => byId.get(g) && <span class={`pill c-${byId.get(g)!.data.cor}`}>{byId.get(g)!.data.nome}</span>)}
                  <span class="tiny muted">{dataCurta(a.data.data)}</span>
                </div>
                <h3 style="font-size:21px"><a href={u(`/avisos/${a.id}`)}>{a.data.titulo}</a></h3>
                <div class="body"><C /></div>
                {a.data.ligazon && <a href={a.data.ligazon} target="_blank" rel="noopener noreferrer" class="btn sm line" style="align-self:flex-start">Abrir <Icon name="out" size={15} /></a>}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <aside class="stack">
      <div class="stack-sm">
        <span class="eyebrow">Grupos {sitio.curso}</span>
        {mats.map((m) => (
          <a href={u(`/materias/${m.id}`)} class={`subject-card hover c-${m.data.cor}`} style="min-height:0;padding:18px;gap:6px"
            data-group-card={m.id} data-group-name={m.data.nome}>
            <div class="row between"><h3>{m.data.nome}</h3><span class="meta">{m.data.curso}</span></div>
            <span class="small" style="color:var(--ink);opacity:.75">{agora.get(m.id) ? `Agora: ${agora.get(m.id)!.data.titulo}` : sigla(m)}</span>
          </a>
        ))}
      </div>
      <div class="card stack-sm">
        <span class="eyebrow">Atallos</span>
        {sitio.palaestra && <a class="row between" href={sitio.palaestra} target="_blank" rel="noopener noreferrer"><b>Palaestra</b><span class="muted small">practicar xogando ↗</span></a>}
        {sitio.pau && <a class="row between" href={sitio.pau} target="_blank" rel="noopener noreferrer"><b>Web da PAU</b><span class="muted small">↗</span></a>}
        <a class="row between" href={u("/calendario")}><b>Calendario</b><span class="muted small">→</span></a>
        <a class="row between" href={u("/gramatica")}><b>Gramática</b><span class="muted small">→</span></a>
        <a class="row between" href={u("/saidas")}><b>Viaxe e saídas</b><span class="muted small">→</span></a>
      </div>
    </aside>
  </div>
</Base>
