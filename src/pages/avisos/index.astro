---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import { u, isExternal, materias, avisos, dataCurta } from "../../lib/util";
const mats = await materias();
const byId = new Map(mats.map((m) => [m.id, m]));
const all = (await avisos()).sort((a, b) => Number(b.data.fixado) - Number(a.data.fixado));
const rendered = await Promise.all(all.map(async (a) => (await render(a)).Content));
---
<Base title="Avisos">
  <div class="stack" style="gap:24px;max-width:760px">
    <div class="big-hello"><span class="eyebrow">Avisos</span><h1>O que hai que saber.</h1></div>
    <nav class="chips" aria-label="Filtrar" data-filter>
      <a href="#" aria-current="true" data-g="">Todos</a>
      {mats.map((m) => <a href={`#${m.id}`} data-g={m.id}>{m.data.nome}</a>)}
    </nav>
    <div class="feed">
      {all.map((a, i) => {
        const C = rendered[i];
        return (
          <article class={`post-card ${a.data.fixado ? "pinned" : ""}`} data-groups={a.data.grupos.join(" ")} id={a.id}>
            <div class="row" style="gap:8px">
              {a.data.fixado && <span class="pill accent">Fixado</span>}
              {a.data.etiqueta && <span class="pill">{a.data.etiqueta}</span>}
              {a.data.grupos.length === 0 && <span class="pill line">Todo o departamento</span>}
              {a.data.grupos.map((g) => byId.get(g) && <span class={`pill c-${byId.get(g)!.data.cor}`}>{byId.get(g)!.data.nome}</span>)}
              <span class="tiny muted">{dataCurta(a.data.data)}</span>
            </div>
            <h3 style="font-size:21px"><a href={u(`/avisos/${a.id}`)}>{a.data.titulo}</a></h3>
            <div class="body"><C /></div>
            {a.data.ligazon && <a href={isExternal(a.data.ligazon) ? a.data.ligazon : u(a.data.ligazon)} {...(isExternal(a.data.ligazon) ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="btn sm line" style="align-self:flex-start">Abrir <Icon name="out" size={15} /></a>}
          </article>
        );
      })}
    </div>
  </div>
  <script>
    const nav = document.querySelector("[data-filter]");
    function apply() {
      const g = location.hash.slice(1);
      nav?.querySelectorAll<HTMLAnchorElement>("a").forEach((a) => a.setAttribute("aria-current", String((a.dataset.g || "") === g)));
      document.querySelectorAll<HTMLElement>("[data-groups]").forEach((el) => {
        const gs = (el.dataset.groups || "").split(" ").filter(Boolean);
        el.hidden = !!g && gs.length > 0 && !gs.includes(g);
      });
    }
    nav?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a");
      if (!a) return; e.preventDefault();
      history.replaceState(null, "", a.dataset.g ? "#" + a.dataset.g : location.pathname); apply();
    });
    apply();
  </script>
</Base>
